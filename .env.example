# 复制为 .env 后填写。不要把真实 Key 提交到 Git。

APP_HOST=127.0.0.1
APP_PORT=8090

# 客户自备模型（OpenAI 兼容）。Key 只保存在本机。
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=

# 规则统计默认值（也可在页面修改）
TIMEOUT_SECONDS=180
SESSION_GAP_HOURS=12

# 可选。不填则使用安装目录下的 data/。页面「系统设置」也可改，写入 data-dir.txt，重启后生效。
# JUDY_DATA_DIR=

# 场景包：一期固定客服，代码尚未按包加载。不要在页面做切换。
# 销售/个人包立项时再启用：LINGXI_SCENARIO=cs|sales|personal
